{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kukcha-doors.up.railway.app/api/:path*"
    },
    {
      "source": "/products/:id",
      "destination": "/_seo/products/:id.html"
    },
    {
      "source": "/products",
      "destination": "/_seo/products.html"
    },
    {
      "source": "/about",
      "destination": "/_seo/about.html"
    },
    {
      "source": "/partners",
      "destination": "/_seo/partners.html"
    },
    {
      "source": "/designers",
      "destination": "/_seo/designers.html"
    },
    {
      "source": "/builders",
      "destination": "/_seo/builders.html"
    },
    {
      "source": "/video",
      "destination": "/_seo/video.html"
    },
    {
      "source": "/our-partners",
      "destination": "/_seo/our-partners.html"
    }
  ]
}
